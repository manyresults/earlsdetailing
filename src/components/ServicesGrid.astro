---
import ServiceCard from "./ServiceCard.astro";
import type { Service } from "../data/site";

interface Props {
  services: Service[];
}
const { services } = Astro.props;
---

<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
  {services.map((service) => <ServiceCard {...service} />)}
</div>
