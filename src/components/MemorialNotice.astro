---
/**
 * In-memoriam + announcement block shown above the homepage hero.
 * Intentionally quieter than the rest of the site: muted tones, generous
 * spacing, a single soft accent. Content comes from `memorial` in site.ts.
 */
import Icon from "./Icon.astro";
import { memorial, site } from "../data/site";

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${memorial.venue.name}, ${memorial.venue.address}`
)}`;
---

<section class="border-b border-line bg-ink-2" aria-label="In memory of Earl Roberts">
  <!-- soft top accent -->
  <div class="h-1 w-full bg-gradient-to-r from-transparent via-brand to-transparent opacity-60"></div>

  <div class="container-page py-14 sm:py-20">
    <!-- Header: banner graphic if provided, otherwise a text header -->
    {
      memorial.bannerImage ? (
        <div class="text-center">
          <img
            src={memorial.bannerImage}
            alt={`In Loving Memory of ${memorial.name} — a devoted father, friend, and small business owner`}
            class="mx-auto w-full max-w-3xl rounded-xl border border-line"
            loading="eager"
          />
          <h2 class="sr-only">In Loving Memory of {memorial.name}</h2>
        </div>
      ) : (
        <div class="text-center">
          <div class="mx-auto mb-4 inline-flex h-11 w-11 items-center justify-center rounded-full border border-line text-brand">
            <Icon name="heart" class="h-5 w-5" fill="currentColor" strokeWidth={0} />
          </div>
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-muted">{memorial.eyebrow}</p>
          <h2 class="mt-3 font-display text-4xl font-bold uppercase tracking-wide text-fg sm:text-5xl">
            {memorial.name}
          </h2>
          <p class="mt-2 text-muted">{memorial.subtitle}</p>
        </div>
      )
    }

    <!-- Portrait of Earl (optional) -->
    {
      memorial.portraitImage && (
        <figure class="mx-auto mt-8 max-w-xs">
          <img
            src={memorial.portraitImage}
            alt={memorial.name}
            class="mx-auto w-full rounded-xl border border-line"
            loading="lazy"
          />
        </figure>
      )
    }

    <!-- Message -->
    <div class="mx-auto mt-10 max-w-2xl space-y-4 text-center text-[15px] leading-relaxed text-muted sm:text-base">
      {memorial.message.map((p) => <p>{p}</p>)}
    </div>

    <!-- Service details -->
    <div class="mx-auto mt-12 max-w-3xl rounded-2xl border border-line bg-surface p-6 sm:p-8">
      <div class="text-center">
        <p class="font-display text-2xl font-bold uppercase tracking-wide text-fg">
          {memorial.serviceHeading}
        </p>
        <p class="mt-2 flex items-center justify-center gap-2 text-muted">
          <Icon name="calendar" class="h-4 w-4 text-brand" />
          {memorial.serviceDate}
        </p>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          memorial.events.map((ev) => (
            <div class="rounded-xl border border-line bg-ink-2 p-5 text-center">
              <h3 class="font-display text-lg font-semibold uppercase tracking-wide text-brand-light">
                {ev.title}
              </h3>
              <p class="mt-2 flex items-center justify-center gap-2 text-fg">
                <Icon name="clock" class="h-4 w-4 text-muted" />
                {ev.time}
              </p>
            </div>
          ))
        }
      </div>

      <a
        href={mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 flex items-start justify-center gap-2 rounded-xl border border-line bg-ink-2 p-5 text-center transition-colors hover:border-brand/60"
      >
        <Icon name="pin" class="mt-0.5 h-4 w-4 shrink-0 text-brand" />
        <span class="text-fg">
          <span class="font-semibold">{memorial.venue.name}</span><br />
          <span class="text-muted">{memorial.venue.address}</span>
        </span>
      </a>

      <p class="mt-6 border-t border-line pt-6 text-center text-sm italic leading-relaxed text-muted">
        {memorial.dressNote}
      </p>
    </div>

    <!-- Closing / still open -->
    <div class="mx-auto mt-12 max-w-2xl space-y-4 text-center text-[15px] leading-relaxed text-muted sm:text-base">
      {memorial.closing.map((p) => <p>{p}</p>)}
    </div>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={`tel:${site.phoneRaw}`} class="btn btn-primary">
        <Icon name="phone" class="h-5 w-5" /> Call {site.phone}
      </a>
      <a href={`sms:${site.phoneRaw}`} class="btn btn-outline">
        <Icon name="message" class="h-5 w-5" /> Text Us
      </a>
    </div>
  </div>
</section>
