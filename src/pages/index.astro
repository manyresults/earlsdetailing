---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactButtons from "../components/ContactButtons.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import CTASection from "../components/CTASection.astro";
import Icon from "../components/Icon.astro";
import { site, detailingServices, vehicleTypes } from "../data/site";

import heroImg from "../assets/images/work/work-06.jpg";
import ceramicImg from "../assets/images/ceramic-special.png";

// Gallery preview — first six completed-work photos.
const work = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>("../assets/images/work/*.jpg", {
    eager: true,
  })
)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);
const preview = work.slice(0, 6);

const pillars = [
  { title: "Cleaning", desc: "Wash & interior deep clean", icon: "droplet", href: "/services/#detailing" },
  { title: "Detail", desc: "Paint correction & polish", icon: "sparkles", href: "/services/#detailing" },
  { title: "Protection", desc: "Waxing & ceramic coating", icon: "shield", href: "/services/#detailing" },
  { title: "Painting", desc: "Body, caliper & bedliner", icon: "spray", href: "/services/#bodywork" },
];

const reasons = [
  { title: "20+ Years of Experience", desc: "Two decades of professional detailing and body work.", icon: "clock" },
  { title: "4x Best of Bucks", desc: "Four consecutive Best of Bucks awards from our community.", icon: "award" },
  { title: "Professional-Grade Products", desc: "Only the best products and equipment — at competitive prices.", icon: "shield" },
  { title: "Local & Trusted", desc: "A local business built on solid, lasting customer relationships.", icon: "pin" },
];
---

<BaseLayout
  title={site.name}
  description="Auto detailing in Langhorne, PA. Washing, waxing, polishing, ceramic coating, paint & body work. 20+ years of experience and four consecutive Best of Bucks awards."
>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden">
    <Image
      src={heroImg}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-ink/90 via-ink/85 to-ink"></div>
    <div class="container-page relative py-24 sm:py-32 lg:py-40">
      <p class="text-sm font-semibold uppercase tracking-[0.25em] text-brand">
        Auto Detailing in {site.address.city}, {site.address.state}
      </p>
      <h1 class="mt-4 max-w-3xl font-display text-4xl font-bold uppercase leading-[1.05] tracking-wide text-fg sm:text-6xl">
        Earl's Proper Detailing
      </h1>
      <p class="mt-4 font-display text-xl uppercase tracking-[0.2em] text-brand sm:text-2xl">
        {site.tagline} &middot; {site.subTagline}
      </p>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
        Washing, waxing, polishing, interior — we do it all. With {site.experience}
        and {site.awards.toLowerCase()}, you know Earl's Proper Detailing is your best bet.
      </p>
      <div class="mt-9">
        <ContactButtons />
      </div>
      <div class="mt-6">
        <a href="/services/" class="inline-flex items-center gap-1 text-sm font-semibold text-fg hover:text-brand">
          Explore our services <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- Vehicle types -->
  <section class="border-b border-line bg-ink-2">
    <div class="container-page py-8">
      <ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6 sm:justify-between">
        {
          vehicleTypes.map((v) => (
            <li class="flex items-center gap-3 text-muted">
              <Icon name={v.icon} class="h-7 w-7 text-brand" />
              <span class="font-display text-lg uppercase tracking-wide">{v.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Service pillars -->
  <section class="container-page py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand">What we do</p>
      <h2 class="mt-3 font-display text-3xl font-bold uppercase tracking-wide text-fg sm:text-4xl">
        Full-Service Auto Detailing
      </h2>
      <p class="mt-4 text-muted">
        From a quick wash to full paint correction, ceramic coating and body work — every vehicle leaves with a proper shine.
      </p>
    </div>
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        pillars.map((p) => (
          <a
            href={p.href}
            class="group rounded-xl border border-line bg-surface p-6 text-center transition-colors hover:border-brand/60"
          >
            <div class="mx-auto mb-4 inline-flex h-14 w-14 items-center justify-center rounded-full bg-brand/10 text-brand">
              <Icon name={p.icon} class="h-7 w-7" />
            </div>
            <h3 class="font-display text-lg font-semibold uppercase tracking-wide text-fg">{p.title}</h3>
            <p class="mt-1 text-sm text-muted">{p.desc}</p>
          </a>
        ))
      }
    </div>

    <div class="mt-14">
      <h3 class="mb-6 font-display text-2xl font-bold uppercase tracking-wide text-fg">
        Detailing Services
      </h3>
      <ServicesGrid services={detailingServices} />
      <div class="mt-8 text-center">
        <a href="/services/" class="btn btn-outline">
          See all services &amp; body work <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- Ceramic promo -->
  <section class="border-y border-line bg-ink-2">
    <div class="container-page grid items-center gap-10 py-16 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand">Featured Special</p>
        <h2 class="mt-3 font-display text-3xl font-bold uppercase tracking-wide text-fg sm:text-4xl">
          Ceramic Coating Sale
        </h2>
        <p class="mt-4 max-w-lg text-muted">
          Earl's Proper ceramic coating creates a barrier from harsh elements and can last for years.
          Unparalleled shine that preserves — and can even increase — your vehicle's value.
        </p>
        <p class="mt-6 font-display text-2xl font-bold uppercase tracking-wide text-fg">
          Packages start at $800
        </p>
        <p class="mt-1 text-brand-light">Mention this ad for 10% off!</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/specials/" class="btn btn-outline">View all specials</a>
          <a href={`tel:${site.phoneRaw}`} class="btn btn-primary">
            <Icon name="phone" class="h-5 w-5" /> Call {site.phone}
          </a>
        </div>
      </div>
      <div class="overflow-hidden rounded-xl border border-line bg-surface">
        <Image
          src={ceramicImg}
          alt="Earl's Proper Detailing ceramic coating sale"
          class="h-full w-full object-cover"
          loading="lazy"
          widths={[400, 700]}
          sizes="(min-width: 1024px) 40vw, 90vw"
        />
      </div>
    </div>
  </section>

  <!-- Why choose us -->
  <section class="container-page py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand">Why Earl's Proper</p>
      <h2 class="mt-3 font-display text-3xl font-bold uppercase tracking-wide text-fg sm:text-4xl">
        Proper Is the Only Option
      </h2>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        reasons.map((r) => (
          <div class="rounded-xl border border-line bg-surface p-6">
            <Icon name={r.icon} class="h-8 w-8 text-brand" />
            <h3 class="mt-4 font-display text-lg font-semibold uppercase tracking-wide text-fg">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{r.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Gallery preview -->
  <section class="border-t border-line bg-ink-2">
    <div class="container-page py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand">Our work</p>
          <h2 class="mt-3 font-display text-3xl font-bold uppercase tracking-wide text-fg sm:text-4xl">
            Recent Results
          </h2>
        </div>
        <a href="/gallery/" class="btn btn-outline">View full gallery</a>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3">
        {
          preview.map((photo, i) => (
            <div class="aspect-[4/3] overflow-hidden rounded-lg border border-line">
              <Image
                src={photo}
                alt={`Completed detailing work by Earl's Proper Detailing (${i + 1})`}
                class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
                loading="lazy"
                widths={[300, 600]}
                sizes="(min-width: 640px) 30vw, 45vw"
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
