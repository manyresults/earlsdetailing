---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import CTASection from "../components/CTASection.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";

const photos = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>("../assets/images/work/*.jpg", {
    eager: true,
  })
)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);
---

<BaseLayout
  title="Gallery"
  description="See completed auto detailing, ceramic coating, paint and body work by Earl's Proper Detailing in Langhorne, PA."
>
  <PageHeader
    eyebrow="Our work"
    title="Gallery"
    subtitle="A look at recent detailing, paint and body work. For the full archive, visit our Facebook page."
  />

  <section class="container-page py-16 sm:py-20">
    <div class="[column-fill:_balance] gap-4 sm:columns-2 lg:columns-3">
      {
        photos.map((photo, i) => (
          <div class="mb-4 break-inside-avoid overflow-hidden rounded-lg border border-line">
            <Image
              src={photo}
              alt={`Completed work by Earl's Proper Detailing — photo ${i + 1}`}
              class="w-full transition-transform duration-500 hover:scale-[1.03]"
              loading="lazy"
              widths={[400, 800]}
              sizes="(min-width: 1024px) 32vw, (min-width: 640px) 48vw, 100vw"
            />
          </div>
        ))
      }
    </div>

    <div class="mt-12 text-center">
      <a
        href={site.social.facebook}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-outline"
      >
        <Icon name="facebook" class="h-5 w-5" /> See more on Facebook
      </a>
    </div>
  </section>

  <CTASection title="Want results like these?" />
</BaseLayout>
