---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import CTASection from "../components/CTASection.astro";
import Icon from "../components/Icon.astro";
import { detailingServices, bodyServices, vehicleTypes } from "../data/site";
---

<BaseLayout
  title="Services"
  description="Auto detailing & body work in Langhorne, PA — wash & wax, interior deep clean, polishing, paint correction, ceramic coating, body paint, dent & collision repair, wheels, calipers and bedliners."
>
  <PageHeader
    eyebrow="What we offer"
    title="Our Services"
    subtitle="Cars, trucks, motorcycles, watercraft and commercial vehicles — from a wash-and-wax to full paint correction, ceramic coating and collision repair."
  />

  <!-- Auto Detailing -->
  <section id="detailing" class="container-page scroll-mt-24 py-16 sm:py-20">
    <div class="mb-8 flex items-center gap-3">
      <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-brand/10 text-brand">
        <Icon name="sparkles" class="h-6 w-6" />
      </span>
      <h2 class="font-display text-3xl font-bold uppercase tracking-wide text-fg">Auto Detailing</h2>
    </div>
    <ServicesGrid services={detailingServices} />
  </section>

  <!-- Auto Body -->
  <section id="bodywork" class="border-t border-line bg-ink-2">
    <div class="container-page scroll-mt-24 py-16 sm:py-20">
      <div class="mb-8 flex items-center gap-3">
        <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-brand/10 text-brand">
          <Icon name="spray" class="h-6 w-6" />
        </span>
        <h2 class="font-display text-3xl font-bold uppercase tracking-wide text-fg">Auto Body</h2>
      </div>
      <ServicesGrid services={bodyServices} />
    </div>
  </section>

  <!-- Vehicles + pricing -->
  <section class="container-page py-16 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-bold uppercase tracking-wide text-fg">
          Vehicles We Service
        </h2>
        <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3">
          {
            vehicleTypes.map((v) => (
              <li class="flex items-center gap-3 rounded-lg border border-line bg-surface px-4 py-3 text-muted">
                <Icon name={v.icon} class="h-6 w-6 text-brand" />
                <span class="font-medium text-fg">{v.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="rounded-xl border border-line bg-surface p-8">
        <h2 class="font-display text-2xl font-bold uppercase tracking-wide text-fg">Pricing</h2>
        <p class="mt-4 text-muted">
          Every vehicle is different, so we offer <strong class="text-fg">custom pricing</strong> with
          <strong class="text-fg"> packages available</strong> to fit your needs and budget.
        </p>
        <p class="mt-3 text-muted">
          Tell us what you're looking for and we'll put together a free, no-obligation quote.
        </p>
        <a href="/contact/" class="btn btn-primary mt-6">
          Get a Free Quote <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <CTASection title="Not sure what your vehicle needs?" subtitle="Call or text and we'll recommend the right package." />
</BaseLayout>
